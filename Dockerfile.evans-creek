ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/p2ppsr/metanet-apps-overlay" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"

WORKDIR /app

# CARS normally performs this assembly. This target exists so Evans Creek can
# produce the same thin runtime during an operator-managed recovery or cutover.
RUN /usr/local/bin/node /usr/local/lib/node_modules/npm/bin/npm-cli.js install --omit=dev --ignore-scripts --no-save \
      @bsv/overlay-topics@1.6.0 \
      @bsv/overlay@2.2.0 \
      @bsv/sdk@2.1.7 \
      mongodb@7.5.0 \
      body-parser@2.3.0 \
      esbuild@0.27.4 \
      lodash@4.18.1 \
      path-to-regexp@8.4.2 \
      qs@6.15.3 \
      uuid@13.0.2 \
  && rm -rf /app/src \
  && mkdir -p /app/src

# The canonical topics package is ESM-only. Older CARS engine images omitted
# this marker, causing tsx to compile the adapters through CommonJS `require`.
RUN /usr/local/bin/node --input-type=module -e \
  "import fs from 'node:fs'; const path='/app/package.json'; const pkg=JSON.parse(fs.readFileSync(path,'utf8')); pkg.type='module'; fs.writeFileSync(path, JSON.stringify(pkg, null, 2) + '\\n')"

COPY backend/src/ /app/src/
